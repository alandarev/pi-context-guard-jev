{
  "name": "pi-context-guard-jev",
  "version": "0.3.1",
  "description": "Pi extension that removes tool output the agent no longer needs from its context. The Jev classifier keeps the needed lines verbatim; stale small outputs, unrelated old exchanges and old screenshots become one-line notes. Everything can be recalled.",
  "type": "module",
  "license": "MIT",
  "author": "alandarev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alandarev/pi-context-guard-jev.git"
  },
  "homepage": "https://github.com/alandarev/pi-context-guard-jev#readme",
  "bugs": {
    "url": "https://github.com/alandarev/pi-context-guard-jev/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "context",
    "jev",
    "typesafe",
    "openrouter",
    "context-window",
    "token-savings",
    "coding-agent"
  ],
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/alandarev/pi-context-guard-jev/master/assets/screenshot.png"
  },
  "scripts": {
    "test": "node --test test/unit/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22.18"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.0.3",
    "@earendil-works/pi-coding-agent": "^1.0.3",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
